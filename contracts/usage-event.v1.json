{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas-factory:schemas:usage-event:v1",
  "title": "UsageEvent v1",
  "description": "Usage event envelope emitted by ATLAS Factory products. Generated from @atlas/contracts (zod); do not edit by hand.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^evt_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "event_type": {
          "type": "string",
          "const": "page_viewed"
        },
        "product_id": {
          "type": "string",
          "enum": [
            "wedding-pilot"
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "anonymous_user_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "traffic_source": {
          "type": "string",
          "enum": [
            "real",
            "synthetic"
          ]
        },
        "properties": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^\\/[a-z0-9/_-]*$"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        },
        "consent_context": {
          "type": "object",
          "properties": {
            "analytics": {
              "type": "string",
              "const": "anonymous"
            }
          },
          "required": [
            "analytics"
          ],
          "additionalProperties": false
        },
        "schema_version": {
          "type": "number",
          "const": 1
        }
      },
      "required": [
        "event_id",
        "event_type",
        "product_id",
        "occurred_at",
        "session_id",
        "anonymous_user_id",
        "traffic_source",
        "properties",
        "consent_context",
        "schema_version"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^evt_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "event_type": {
          "type": "string",
          "const": "programme_viewed"
        },
        "product_id": {
          "type": "string",
          "enum": [
            "wedding-pilot"
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "anonymous_user_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "traffic_source": {
          "type": "string",
          "enum": [
            "real",
            "synthetic"
          ]
        },
        "properties": {
          "type": "object",
          "properties": {
            "highlighted_step_kind": {
              "type": "string",
              "enum": [
                "current",
                "next",
                "none"
              ]
            }
          },
          "additionalProperties": false
        },
        "consent_context": {
          "type": "object",
          "properties": {
            "analytics": {
              "type": "string",
              "const": "anonymous"
            }
          },
          "required": [
            "analytics"
          ],
          "additionalProperties": false
        },
        "schema_version": {
          "type": "number",
          "const": 1
        }
      },
      "required": [
        "event_id",
        "event_type",
        "product_id",
        "occurred_at",
        "session_id",
        "anonymous_user_id",
        "traffic_source",
        "properties",
        "consent_context",
        "schema_version"
      ],
      "additionalProperties": false
    }
  ]
}
